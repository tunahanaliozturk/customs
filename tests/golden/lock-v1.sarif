{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "customs",
          "version": "0.0.0",
          "semanticVersion": "0.0.0",
          "informationUri": "https://github.com/tunahanaliozturk/customs",
          "rules": [
            {
              "id": "C003",
              "shortDescription": {
                "text": "An entry with `..`, an absolute path or a drive letter, two entries whose names are equal ignoring case, or a link in a package folder."
              },
              "helpUri": "https://github.com/tunahanaliozturk/customs/blob/main/docs/design.md#rules",
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "C004",
              "shortDescription": {
                "text": "An MSBuild file that is not well-formed XML, has a DTD, or uses an encoding other than UTF-8 or UTF-16."
              },
              "helpUri": "https://github.com/tunahanaliozturk/customs/blob/main/docs/design.md#rules",
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "C101",
              "shortDescription": {
                "text": "Build assets: props or targets in build/, buildTransitive/, buildMultitargeting/ or buildCrossTargeting/."
              },
              "helpUri": "https://github.com/tunahanaliozturk/customs/blob/main/docs/design.md#rules",
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "C102",
              "shortDescription": {
                "text": "Analyzer or source generator assembly in analyzers/."
              },
              "helpUri": "https://github.com/tunahanaliozturk/customs/blob/main/docs/design.md#rules",
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "C103",
              "shortDescription": {
                "text": "PowerShell script in tools/."
              },
              "helpUri": "https://github.com/tunahanaliozturk/customs/blob/main/docs/design.md#rules",
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "C104",
              "shortDescription": {
                "text": "Native binary: in runtimes/*/native/, or an ELF or Mach-O file anywhere."
              },
              "helpUri": "https://github.com/tunahanaliozturk/customs/blob/main/docs/design.md#rules",
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "C105",
              "shortDescription": {
                "text": "contentFiles source code that will be compiled into the project."
              },
              "helpUri": "https://github.com/tunahanaliozturk/customs/blob/main/docs/design.md#rules",
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "C201",
              "shortDescription": {
                "text": "UsingTask with a TaskFactory: CodeTaskFactory, RoslynCodeTaskFactory or any other."
              },
              "helpUri": "https://github.com/tunahanaliozturk/customs/blob/main/docs/design.md#rules",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "C202",
              "shortDescription": {
                "text": "UsingTask with AssemblyFile: an assembly that MSBuild loads."
              },
              "helpUri": "https://github.com/tunahanaliozturk/customs/blob/main/docs/design.md#rules",
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "C203",
              "shortDescription": {
                "text": "Exec task."
              },
              "helpUri": "https://github.com/tunahanaliozturk/customs/blob/main/docs/design.md#rules",
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "C204",
              "shortDescription": {
                "text": "DownloadFile task."
              },
              "helpUri": "https://github.com/tunahanaliozturk/customs/blob/main/docs/design.md#rules",
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "C205",
              "shortDescription": {
                "text": "A URL (http, https, ftp) in an attribute value or element text. Comments are ignored."
              },
              "helpUri": "https://github.com/tunahanaliozturk/customs/blob/main/docs/design.md#rules",
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "C206",
              "shortDescription": {
                "text": "A base64-looking run of at least 200 characters."
              },
              "helpUri": "https://github.com/tunahanaliozturk/customs/blob/main/docs/design.md#rules",
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "C207",
              "shortDescription": {
                "text": "An Import that cannot be resolved inside the package."
              },
              "helpUri": "https://github.com/tunahanaliozturk/customs/blob/main/docs/design.md#rules",
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "C301",
              "shortDescription": {
                "text": "Module initialiser: <Module> has a .cctor. An error in an analyzer or build-time assembly."
              },
              "helpUri": "https://github.com/tunahanaliozturk/customs/blob/main/docs/design.md#rules",
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "C302",
              "shortDescription": {
                "text": "P/Invoke that changes memory protection or writes to another process. An error in an analyzer or build-time assembly."
              },
              "helpUri": "https://github.com/tunahanaliozturk/customs/blob/main/docs/design.md#rules",
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "C303",
              "shortDescription": {
                "text": "Marker of a known obfuscator. A warning in an analyzer or build-time assembly."
              },
              "helpUri": "https://github.com/tunahanaliozturk/customs/blob/main/docs/design.md#rules",
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "C304",
              "shortDescription": {
                "text": "A .dll or .exe where NuGet expects managed code that is not a readable managed assembly. An error in an analyzer or build-time assembly."
              },
              "helpUri": "https://github.com/tunahanaliozturk/customs/blob/main/docs/design.md#rules",
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "C401",
              "shortDescription": {
                "text": "Package ID with characters outside ASCII."
              },
              "helpUri": "https://github.com/tunahanaliozturk/customs/blob/main/docs/design.md#rules",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "C402",
              "shortDescription": {
                "text": "Package ID that looks like a popular ID: the same skeleton under Unicode confusables."
              },
              "helpUri": "https://github.com/tunahanaliozturk/customs/blob/main/docs/design.md#rules",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "C403",
              "shortDescription": {
                "text": "Package ID one edit, or only separators, away from a popular ID, and not itself popular."
              },
              "helpUri": "https://github.com/tunahanaliozturk/customs/blob/main/docs/design.md#rules",
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ],
          "notifications": [
            {
              "id": "C001",
              "shortDescription": {
                "text": "A package in the graph was not found on disk, or a file of it could not be read."
              }
            },
            {
              "id": "C002",
              "shortDescription": {
                "text": "A limit stopped reading. The message names the limit and the file."
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": [],
          "toolConfigurationNotifications": []
        }
